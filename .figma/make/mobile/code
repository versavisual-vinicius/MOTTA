                // Filter Tabs logic
                const chips = document.querySelectorAll(".filter-chip");
                const serviceItems = document.querySelectorAll(".service-item");
                const searchInput = document.getElementById("serviceSearch");
                const noResults = document.getElementById("noResultsState");
                const serviceCount = document.getElementById("serviceCount");

                let currentCategory = "all";

                function applyFilters() {
                    const query = (searchInput.value || "")
                        .toLowerCase()
                        .trim();
                    let visibleCount = 0;

                    serviceItems.forEach((item) => {
                        const category = item.getAttribute("data-category");
                        const textData = (
                            item.getAttribute("data-name") || ""
                        ).toLowerCase();
                        const matchesCategory =
                            currentCategory === "all" ||
                            category === currentCategory;
                        const matchesSearch =
                            !query || textData.includes(query);

                        if (matchesCategory && matchesSearch) {
                            item.classList.remove("hidden");
                            visibleCount++;
                        } else {
                            item.classList.add("hidden");
                        }
                    });

                    if (visibleCount === 0) {
                        noResults.classList.remove("hidden");
                        noResults.classList.add("flex");
                    } else {
                        noResults.classList.add("hidden");
                        noResults.classList.remove("flex");
                    }

                    serviceCount.textContent = `${visibleCount} ${visibleCount === 1 ? "disponível" : "disponíveis"}`;
                }

                chips.forEach((chip) => {
                    chip.addEventListener("click", () => {
                        chips.forEach((c) => {
                            c.classList.remove(
                                "bg-brand-700",
                                "text-on-primary",
                            );
                            c.classList.add(
                                "bg-surface-card",
                                "text-neutral-700",
                            );
                        });
                        chip.classList.add("bg-brand-700", "text-on-primary");
                        chip.classList.remove(
                            "bg-surface-card",
                            "text-neutral-700",
                        );
                        currentCategory = chip.getAttribute("data-filter");
                        applyFilters();
                    });
                });

                searchInput.addEventListener("input", applyFilters);

                // Collapsible toggle for Extra Services
                const toggleExtra = document.getElementById(
                    "toggleExtraServices",
                );
                const extraContent = document.getElementById(
                    "extraServicesContent",
                );
                const extraIcon = document.getElementById("extraServicesIcon");

                let isExtraOpen = true;
                toggleExtra.addEventListener("click", () => {
                    isExtraOpen = !isExtraOpen;
                    if (isExtraOpen) {
                        extraContent.classList.remove("hidden");
                        extraIcon.style.transform = "rotate(0deg)";
                    } else {
                        extraContent.classList.add("hidden");
                        extraIcon.style.transform = "rotate(-90deg)";
                    }
                });

                // CTA button micro-interaction
                const cta = document.getElementById("ctaSubscribe");
                cta.addEventListener("click", () => {
                    const originalText = cta.innerHTML;
                    cta.innerHTML =
                        '<span class="material-symbols-outlined text-[20px] animate-spin">progress_activity</span><span>Processando...</span>';
                    setTimeout(() => {
                        cta.innerHTML =
                            '<span class="material-symbols-outlined text-[20px] text-accent-gold">check</span><span>Plano Ativado com Sucesso!</span>';
                        cta.classList.remove("bg-brand-700");
                        cta.classList.add("bg-brand-800");
                        setTimeout(() => {
                            cta.innerHTML = originalText;
                            cta.classList.remove("bg-brand-800");
                            cta.classList.add("bg-brand-700");
                        }, 2500);
                    }, 800);
                });
