            <script>
                (function initServiceSelection() {
                    const services = [
                        {
                            id: "1",
                            name: "Corte Masculino Tradicional",
                            duration: 35,
                            price: 0,
                            category: "cabelo",
                            selected: true,
                        },
                        {
                            id: "2",
                            name: "Barba Terapia Toalha Quente",
                            duration: 30,
                            price: 32.3,
                            category: "barba",
                            selected: true,
                        },
                        {
                            id: "3",
                            name: "Sobrancelha na Navalha",
                            duration: 15,
                            price: 20.0,
                            category: "barba",
                            selected: false,
                        },
                        {
                            id: "4",
                            name: "Combo Motta Premium",
                            duration: 60,
                            price: 75.0,
                            category: "combos",
                            selected: false,
                        },
                    ];

                    const cards = document.querySelectorAll(".service-card");
                    const summaryMeta = document.getElementById("summary-meta");
                    const summaryPrice =
                        document.getElementById("summary-price");
                    const continueBtn =
                        document.getElementById("continue-button");
                    const searchInput =
                        document.getElementById("service-search");
                    const clearBtn = document.getElementById("clear-search");
                    const filterChips =
                        document.querySelectorAll(".filter-chip");

                    let currentFilter = "todos";
                    let searchQuery = "";

                    function formatCurrency(val) {
                        return val.toLocaleString("pt-BR", {
                            style: "currency",
                            currency: "BRL",
                        });
                    }

                    function formatDuration(mins) {
                        if (mins < 60) return `${mins} min`;
                        const h = Math.floor(mins / 60);
                        const m = mins % 60;
                        return m > 0
                            ? `${h}h ${String(m).padStart(2, "0")}min`
                            : `${h}h`;
                    }

                    function updateSummary() {
                        const selectedItems = services.filter(
                            (s) => s.selected,
                        );
                        const count = selectedItems.length;
                        const totalMinutes = selectedItems.reduce(
                            (acc, curr) => acc + curr.duration,
                            0,
                        );
                        const totalPrice = selectedItems.reduce(
                            (acc, curr) => acc + curr.price,
                            0,
                        );

                        if (count === 0) {
                            summaryMeta.textContent =
                                "Nenhum serviço selecionado";
                            summaryPrice.textContent = "R$ 0,00";
                            continueBtn.disabled = true;
                            continueBtn.classList.add(
                                "opacity-50",
                                "pointer-events-none",
                            );
                        } else {
                            const itemLabel =
                                count === 1 ? "1 serviço" : `${count} serviços`;
                            summaryMeta.textContent = `${itemLabel} • ${formatDuration(totalMinutes)}`;
                            summaryPrice.textContent =
                                formatCurrency(totalPrice);
                            continueBtn.disabled = false;
                            continueBtn.classList.remove(
                                "opacity-50",
                                "pointer-events-none",
                            );
                        }
                    }

                    function syncCardUI(card, isSelected) {
                        const btn = card.querySelector(".toggle-btn");
                        const icon = btn.querySelector(
                            ".material-symbols-outlined",
                        );

                        if (isSelected) {
                            btn.classList.remove(
                                "bg-surface-container",
                                "text-brand-950",
                            );
                            btn.classList.add(
                                "bg-brand-700",
                                "text-on-primary",
                            );
                            icon.textContent = "check";
                            card.classList.add("bg-surface-card");
                        } else {
                            btn.classList.remove(
                                "bg-brand-700",
                                "text-on-primary",
                            );
                            btn.classList.add(
                                "bg-surface-container",
                                "text-brand-950",
                            );
                            icon.textContent = "add";
                        }
                    }

                    function applyFilters() {
                        cards.forEach((card) => {
                            const title = card
                                .querySelector("h2")
                                .textContent.toLowerCase();
                            const desc = card
                                .querySelector("p")
                                .textContent.toLowerCase();
                            const category = card.dataset.category;

                            const matchesSearch =
                                title.includes(searchQuery) ||
                                desc.includes(searchQuery);
                            const matchesCategory =
                                currentFilter === "todos" ||
                                category === currentFilter;

                            if (matchesSearch && matchesCategory) {
                                card.classList.remove("hidden");
                            } else {
                                card.classList.add("hidden");
                            }
                        });
                    }

                    // Bind card clicking to toggle selection
                    cards.forEach((card) => {
                        card.addEventListener("click", (e) => {
                            const id = card.dataset.id;
                            const service = services.find((s) => s.id === id);
                            if (!service) return;

                            service.selected = !service.selected;
                            card.dataset.selected = String(service.selected);
                            syncCardUI(card, service.selected);
                            updateSummary();
                        });
                    });

                    // Category filter interactions
                    filterChips.forEach((chip) => {
                        chip.addEventListener("click", () => {
                            filterChips.forEach((c) => {
                                c.classList.remove(
                                    "bg-brand-700",
                                    "text-on-primary",
                                );
                                c.classList.add(
                                    "bg-surface-card",
                                    "text-neutral-700",
                                );
                            });
                            chip.classList.remove(
                                "bg-surface-card",
                                "text-neutral-700",
                            );
                            chip.classList.add(
                                "bg-brand-700",
                                "text-on-primary",
                            );

                            currentFilter = chip.dataset.category;
                            applyFilters();
                        });
                    });

                    // Search bar functionality
                    if (searchInput) {
                        searchInput.addEventListener("input", (e) => {
                            searchQuery = e.target.value.trim().toLowerCase();
                            if (searchQuery.length > 0) {
                                clearBtn.classList.remove("hidden");
                            } else {
                                clearBtn.classList.add("hidden");
                            }
                            applyFilters();
                        });

                        clearBtn.addEventListener("click", () => {
                            searchInput.value = "";
                            searchQuery = "";
                            clearBtn.classList.add("hidden");
                            applyFilters();
                            searchInput.focus();
                        });
                    }

                    // Continue CTA interaction
                    if (continueBtn) {
                        continueBtn.addEventListener("click", () => {
                            const selectedServices = services.filter(
                                (s) => s.selected,
                            );
                            if (selectedServices.length > 0) {
                                // Provide subtle tactile micro-feedback
                                continueBtn.classList.add("scale-95");
                                setTimeout(() => {
                                    continueBtn.classList.remove("scale-95");
                                }, 150);
                            }
                        });
                    }

                    // Initial render call
                    updateSummary();
                })();
            </script>
        </main>
    </body>
</html>

